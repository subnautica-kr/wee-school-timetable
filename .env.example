# 이 파일을 .env 로 복사해 값을 채운다:  cp .env.example .env
# 아래 예시 값은 가짜다. 비밀값은 무작위로 만든다:  openssl rand -hex 32

# --- 필수 ---
# PostgreSQL 접속 주소. 도커 compose 는 DB_PASSWORD 로 스스로 만들어 쓰므로 이 줄은 compose 에선 무시된다.
DATABASE_URL=postgres://timetable:change-me@127.0.0.1:5432/timetable
# 로그인 세션 서명 키. 길고 무작위로.
SESSION_SECRET=replace-with-random-hex
# 메모·사유 같은 민감 칸의 암호화 키. 비우면 SESSION_SECRET 으로 대신하지만 따로 두기를 권한다. 한번 정하면 바꾸지 않는다(바꾸면 기존 암호문을 못 연다).
DATA_KEY=replace-with-another-random-hex

# --- 도커 compose 전용 ---
# compose 가 만드는 DB 의 비밀번호
DB_PASSWORD=replace-with-random-hex
# 밖으로 여는 주소·포트. 기본은 이 PC 안에서만(127.0.0.1).
BIND=127.0.0.1
APP_PORT=3000

# --- 선택 ---
# 서버 포트(기본 3000)
PORT=3000
# https 로 접속하면 true(기본). http 로만 시험할 때만 false.
COOKIE_SECURE=true
# 앞단 프록시 단수(기본 1). 프록시 없이 직접 열면 0 또는 false.
TRUST_PROXY=1
# 화면 빌드 결과 위치(기본 web/dist)
# WEB_DIST=web/dist
# 비밀값을 파일로 줄 때: DATABASE_URL_FILE · SESSION_SECRET_FILE · DATA_KEY_FILE 에 파일 경로를 준다.
